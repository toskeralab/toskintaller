{
  "name": "toskintaller",
  "version": "0.1.0",
  "private": true,
  "description": "Toskinstaller — toolchain de empacotamento de apps Freebuff (spike técnico, Iteração 0)",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:spike": "tsx apps/cli/src/index.ts build --config fixtures/example-app/toskintaller.json --all-styles --out release/spike",
    "spike": "pnpm typecheck && pnpm test && pnpm build:spike"
  },
  "devDependencies": {
    "@toskintaller/config": "workspace:*",
    "@toskintaller/core": "workspace:*",
    "@toskintaller/installer-nsis": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}