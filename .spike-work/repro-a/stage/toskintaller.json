{
  "schemaVersion": 1,
  "app": {
    "id": "br.lab.toskerexample",
    "name": "Example App",
    "version": "1.0.0",
    "publisher": "ToskeraLAB"
  },
  "input": {
    "type": "folder",
    "path": ".",
    "entry": "index.html"
  },
  "mode": "installer",
  "installScreen": {
    "title": "Instalando Example App",
    "subtitle": "Feito com Freebuff · ToskeraLAB",
    "footer": "© 2026 ToskeraLAB",
    "banner": {
      "type": "gradient"
    },
    "progress": {
      "style": "smooth",
      "labels": {
        "installing": "Copiando arquivos...",
        "done": "Concluído!"
      }
    },
    "supplemental": [
      {
        "id": "vcredist",
        "label": "Instalar VC++ Redistributable",
        "file": "redist/vcredist_x64.exe",
        "silentArgs": "/quiet /norestart",
        "required": false,
        "defaultChecked": true
      }
    ],
    "finish": {
      "title": "Instalação concluída",
      "message": "Obrigado por instalar!",
      "runAfterInstall": true
    }
  },
  "installer": {
    "targetDir": "%LOCALAPPDATA%",
    "perMachine": false,
    "shortcuts": [],
    "uninstaller": true,
    "silentFlags": {
      "install": "/S",
      "uninstall": "/S"
    }
  },
  "artifact": {
    "outDir": "./release",
    "fileName": "ExampleApp-Setup-1.0.0",
    "compression": "normal"
  }
}