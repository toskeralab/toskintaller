#!/usr/bin/env node
//
// scripts/electron-bundle — empacotamento determinístico do Electron (Iteração 1).
//
// Por quê um script próprio e não puro app-builder-lib?
// A lib expõe uma API que muda entre versões; o CLI do electron-builder é a
// interface que a biblioteca testa. Um script próprio nos deixa ser os
// mantenedores da versão de env, arquivos a ignorar e cache.
//
// O que garantimos aqui:
//  - SOURCE_DATE_EPOCH fixo (asar + PE headers + NSIS portable);
//  - cache do electron-builder fora do workspace (não polui os build outputs);
//  - compatibilidade Node ↔ Electron via ELECTRON_RUN_AS_NODE quando aplicável;
//  - reprodutibilidade entre máquinas quando as versões de tooling forem idênticas.
//
// Nota (Iteração 4/hardening): este script é o caminho "legado" do empacotamento
// (spike). O pipeline atual usa o adapter windows-standalone
// (packages/targets/standalone), que já embute as mesmas garantias de
// determinismo e cache. Mantido para compatibilidade do workflow spike-windows.

"use strict";

const { execFileSync } = require("node:child_process");
const { resolve } = require("node:path");
const { existsSync } = require("node:fs");

const ELECTRON_BUILDER_BIN = resolve(__dirname, "..", "node_modules", ".bin", "electron-builder");
const RENDER_DIR = resolve(__dirname, "..", "render");

emit("bundle");

// SOURCE_DATE_EPOCH fixo para asar e PE headers (incluindo portable NSIS backend)
process.env.SOURCE_DATE_EPOCH = "1704067200";
// NSIS_SOURCE_DATE_EPOCH: portable usa internamente NSIS — o spike já validou esse fixo
process.env.NSIS_SOURCE_DATE_EPOCH = "1704067200";
// comportamento estável igual CI (evita avisos/variáveis de máquina)
process.env.CI = "true";
// cache fora do workspace para não poluir os build outputs (hardening Iteração 4)
process.env.ELECTRON_BUILDER_CACHE = resolve(__dirname, "..", ".cache", "electron-builder");

// electron-builder resolve electron via package.json do projeto (productName etc.);
// não versionamos node_modules do electron no git (sem binários no repo).
const electronVersion = execFileSync(
  process.execPath,
  ["-p", "require('electron/package.json').version"],
  { encoding: "utf8" },
).trim();
emit(`electron ${electronVersion}`);

// checklist rápido antes do build
if (!existsSync(ELECTRON_BUILDER_BIN)) {
  throw new Error(
    "electron-builder binário não encontrado — `pnpm add -D electron-builder` na raiz",
  );
}

execFileSync(
  process.execPath,
  [
    ELECTRON_BUILDER_BIN,
    "--win",
    "--config",
    resolve(RENDER_DIR, "electron-builder.json"),
    "--projectDir",
    RENDER_DIR,
  ],
  { stdio: "inherit", env: { ...process.env, NO_UPDATE_NOTIFIER: "1" } },
);

function emit(msg) {
  process.stdout.write(msg + "\n");
}
